<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono original de TikRatu: un escudo (protección) en técnica duotono/glitch
     cian+rojo desfasados detrás de una silueta clara al frente — el mismo
     recurso visual que usa el logo de TikTok (offset cromático), pero con una
     forma propia (escudo), no una copia de su nota musical. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Capa roja, desfasada -->
    <group android:translateX="4" android:translateY="3">
        <path
            android:fillColor="#FE2C55"
            android:pathData="M54,25 L79,35 L79,58 C79,70 68,80 54,85 C40,80 29,70 29,58 L29,35 Z" />
    </group>

    <!-- Capa cian, desfasada al otro lado -->
    <group android:translateX="-4" android:translateY="-3">
        <path
            android:fillColor="#25F4EE"
            android:pathData="M54,25 L79,35 L79,58 C79,70 68,80 54,85 C40,80 29,70 29,58 L29,35 Z" />
    </group>

    <!-- Silueta al frente -->
    <path
        android:fillColor="#F2F2F5"
        android:pathData="M54,25 L79,35 L79,58 C79,70 68,80 54,85 C40,80 29,70 29,58 L29,35 Z" />

    <!-- Marca de verificación dentro del escudo -->
    <path
        android:fillColor="#0D0D0F"
        android:pathData="M45,55 L51,61 L64,46 L67,49 L51,67 L42,58 Z" />
</vector>
