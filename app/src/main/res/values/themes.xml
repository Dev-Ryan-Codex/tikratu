<resources>
    <!-- Dark-only a propósito (mismo criterio que InstaEclipse: Theme.Material3.Dark.NoActionBar
         + override completo de los color roles M3), en vez de Theme.Material.Light plano. -->
    <style name="Theme.TikRatu" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:colorBackground">@color/tr_background</item>
        <item name="android:statusBarColor">@color/tr_surface</item>
        <item name="android:navigationBarColor">@color/tr_surface_container</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="colorPrimary">@color/tr_primary</item>
        <item name="colorOnPrimary">@color/tr_on_primary</item>
        <item name="colorPrimaryContainer">@color/tr_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/tr_on_primary_container</item>

        <item name="colorSecondary">@color/tr_secondary</item>
        <item name="colorOnSecondary">@color/tr_on_secondary</item>
        <item name="colorSecondaryContainer">@color/tr_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/tr_on_secondary_container</item>

        <item name="colorTertiary">@color/tr_tertiary</item>
        <item name="colorOnTertiary">@color/tr_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tr_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/tr_on_tertiary_container</item>

        <item name="colorError">@color/tr_error</item>
        <item name="colorOnError">@color/tr_on_error</item>

        <item name="colorSurface">@color/tr_surface</item>
        <item name="colorOnSurface">@color/tr_on_surface</item>
        <item name="colorOnBackground">@color/tr_on_surface</item>
        <item name="colorSurfaceVariant">@color/tr_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/tr_on_surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/tr_surface_low</item>
        <item name="colorSurfaceContainer">@color/tr_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/tr_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/tr_surface_highest</item>
        <item name="colorOutline">@color/tr_outline</item>
        <item name="colorOutlineVariant">@color/tr_outline_variant</item>

        <item name="materialSwitchStyle">@style/Widget.TikRatu.Switch</item>
        <item name="bottomNavigationStyle">@style/Widget.TikRatu.BottomNav</item>
    </style>

    <!-- Track/thumb calcados del plugin de referencia (durazno ON, gris oscuro OFF),
         no los colores por defecto de M3 (que usan colorPrimary/colorSurface). -->
    <style name="Widget.TikRatu.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/switch_track</item>
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackDecorationTint">@android:color/transparent</item>
    </style>

    <!-- Bottom nav con "pill" marrón en el ítem activo, calcado del plugin de referencia. -->
    <style name="Widget.TikRatu.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/tr_surface_container</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.TikRatu.BottomNav.ActiveIndicator</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.TikRatu.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/tr_secondary_container</item>
    </style>
</resources>
